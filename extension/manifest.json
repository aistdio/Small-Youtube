{
  "manifest_version": 3,
  "name": "Small-Youtube",
  "version": "0.1.0",
  "description": "Adds videos from small channels next to YouTube's recommendations.",
  "default_locale": "en",
  "minimum_chrome_version": "121",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "src/youtube.js",
        "src/lib/settings.js",
        "src/lib/topic.js",
        "src/lib/language.js",
        "src/content/store.js",
        "src/content/queue.js",
        "src/content/api.js",
        "src/content/pipeline.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "src/youtube-page.js",
        "src/lib/slots.js",
        "src/page/cards.js",
        "src/page/feed.js",
        "src/page/languages.js",
        "src/page/page.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "small-youtube@extension.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
